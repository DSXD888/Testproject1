{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "signin_status",
    "cdp_state",
    "captcha_intercepted",
    "warnings",
    "blockers"
  ],
  "properties": {
    "signin_status": {
      "type": "string",
      "enum": ["signed_in", "manual_required", "blocked"]
    },
    "account_selected": { "type": ["string", "null"] },
    "redirected_to": { "type": ["string", "null"] },
    "signed_in_verified_via": {
      "type": ["string", "null"],
      "enum": ["account_menu_present", "user_info_present", "passport_redirect_absent", null]
    },
    "cdp_state": {
      "type": "string",
      "enum": ["connected", "unreachable", "captcha_blocked", "session_expired"],
      "default": "connected"
    },
    "captcha_intercepted": { "type": "boolean", "default": false },
    "warnings": { "type": "array" },
    "blockers": { "type": "array" }
  }
}
