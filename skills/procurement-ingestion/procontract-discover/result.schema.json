{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cursor",
    "continuation_required",
    "notices"
  ],
  "properties": {
    "cursor": {
      "type": "string"
    },
    "continuation_required": {
      "type": "boolean"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "notice_id",
          "source_notice_id",
          "source_url",
          "title",
          "published_at",
          "source_updated_at",
          "ocid",
          "procurement_stage"
        ],
        "properties": {
          "notice_id": {
            "type": "string"
          },
          "source_notice_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "ocid": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "buyer_name": {
            "type": "string"
          },
          "procurement_stage": {
            "type": "string"
          },
          "main_category": {
            "type": "string"
          },
          "deadline_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": "string"
          },
          "source_updated_at": {
            "type": "string"
          },
          "estimated_value_low_pence": {
            "type": [
              "integer",
              "null"
            ]
          },
          "estimated_value_currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_route": {
            "type": "string"
          },
          "raw_release_json": {
            "type": "string"
          }
        }
      }
    }
  }
}
