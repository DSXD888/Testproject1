            "type": [
              "string",
              "null"
            ]
          },
          "direct_visit_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "enriched",
              "not_yet_responded",
              "failed",
              "blocked"
            ]
          }
        }
      }
