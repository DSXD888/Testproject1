          "process_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "advert_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_notice_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "enriched",
              "not_yet_responded",
              "failed",
              "blocked"
            ]
          },
          "checked_at": {
            "type": "string"
          },
          "discovery_method": {
            "type": "string",
            "enum": [
              "scan",
              "direct",
              "scan_and_direct"
            ]
