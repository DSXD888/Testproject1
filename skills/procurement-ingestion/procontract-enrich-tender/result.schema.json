              "string",
              "null"
            ]
          },
          "discovery_method": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "scan",
              "direct",
              "scan_and_direct",
              null
            ]
          },
          "direct_visit_attempted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "activity_dashboard_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome_detail": {
            "type": [
              "string",
              "null"
            ]
          }
