              "type": "object",
              "required": [
                "filename",
                "content_type",
                "local_path"
              ],
              "properties": {
                "filename": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                },
                "size_bytes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "local_path": {
                  "type": "string"
                },
                "download_url": {
                  "type": [
                    "string",
                    "null"
                  ]
