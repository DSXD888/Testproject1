            "type": [
              "string",
              "null"
            ]
          },
          "advert_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_notice_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_code": {
            "type": "string",
