    "continuation_required": {
      "type": "boolean"
    },
    "enriched_tenders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "notice_id",
          "rfx_id",
          "rfx_url",
          "updated_title",
          "updated_description",
          "updated_deadline_at",
          "buyer_name",
          "documents_downloaded",
          "documents_count",
          "enriched_at"
        ],
        "properties": {
          "notice_id": {
            "type": "string"
          },
          "process_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "advert_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_notice_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rfx_id": {
            "type": "string"
          },
          "rfx_url": {
            "type": "string"
          },
          "updated_title": {
            "type": "string"
          },
          "updated_description": {
            "type": "string"
          },
          "updated_deadline_at": {
            "type": "string"
          },
          "buyer_name": {
            "type": "string"
          },
          "buyer_contact": {
            "type": [
              "object",
              "null"
            ]
          },
          "documents_downloaded": {
            "type": "array",
