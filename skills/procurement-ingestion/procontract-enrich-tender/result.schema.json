              "CDP_CONNECT_FAILED",
              "SESSION_REFRESH_FAILED",
              "PAGE_SHAPE_DRIFT",
              "SOURCE_SOFT_BLOCKED",
              "AGENT_PARTIAL_FAILURE",
              "AGENT_STALLED",
              "AGENT_AUTH_CHALLENGE"
