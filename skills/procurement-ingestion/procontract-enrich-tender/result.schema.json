          },
          "severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "blocked",
              "warning",
              "error",
              null
            ]
          },
          "discovery_method": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "scan",
              "direct",
              "scan_and_direct",
              null
            ]
          },
          "direct_visit_attempted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "direct_visit_url": {
            "type": [
              "string",
              "null"
            ]
          }
