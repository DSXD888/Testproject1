{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "seq",
    "cursor",
    "notices_processed",
    "last_ocid"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "cursor": {
      "type": "string"
    },
    "notices_processed": {
      "type": "integer",
      "minimum": 0
    },
    "last_ocid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ocds-r6ebe6-[0-9]+$"
    },
    "last_publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
