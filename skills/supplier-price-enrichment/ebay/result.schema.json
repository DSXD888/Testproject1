{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_id",
    "batch_summary",
    "search_attempts",
    "supplier_quotes",
    "warnings",
    "extraction_metadata"
  ],
  "properties": {
    "source_id": {
      "const": "ebay"
    },
    "batch_summary": {
      "type": "object",
      "required": [
        "profiles_processed",
        "profiles_skipped",
        "profiles_failed",
        "total_waves_executed",
        "total_listings_shortlisted",
        "total_detail_pages_fetched"
      ],
      "properties": {
        "profiles_processed": {
          "type": "integer",
          "minimum": 0
        },
        "profiles_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "profiles_failed": {
          "type": "integer",
          "minimum": 0
        },
        "total_waves_executed": {
          "type": "integer",
          "minimum": 0
        },
        "total_listings_shortlisted": {
          "type": "integer",
          "minimum": 0
        },
        "total_detail_pages_fetched": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "search_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_candidate_id",
          "search_profile_id",
          "wave_number",
          "strategy",
          "query_text",
          "locale",
          "result_count",
          "hard_rejected_count",
          "shortlisted_count"
        ],
        "properties": {
          "product_candidate_id": {
            "type": "string"
          },
          "search_profile_id": {
            "type": "string"
          },
          "wave_number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "strategy": {
            "type": "string",
            "enum": [
              "exact_anchor",
              "alias_swap",
              "market_frame",
              "broad_existence",
              "compliance_off"
            ]
          },
          "query_text": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "hard_rejected_count": {
            "type": "integer",
            "minimum": 0
          },
          "shortlisted_count": {
            "type": "integer",
            "minimum": 0
          },
          "is_recovery_wave": {
            "type": "boolean"
          },
          "search_failure_mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "vocabulary_gap",
              "overconstrained_query",
              "accessory_swamp",
              "compliance_not_surfaceable",
              "no_marketplace_presence",
              "low_extraction_quality",
              "source_specific_failure"
            ]
          },
          "filters_json": {
            "type": "object"
          },
          "listing_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "supplier_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_candidate_id",
          "search_attempt_id",
          "source_name",
          "source_url",
          "source_listing_id",
          "region",
          "quote_class",
          "price_signal_role",
          "unit_price_original_minor",
          "currency",
          "unit_price_gbp_pence",
          "match_confidence_bps",
          "quote_usability_confidence_bps",
          "evidence"
        ],
        "properties": {
          "product_candidate_id": {
            "type": "string"
          },
          "search_attempt_id": {
            "type": "string"
          },
          "source_name": {
            "const": "eBay"
          },
          "source_url": {
            "type": "string"
          },
          "source_listing_id": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "quote_class": {
            "type": "string",
            "enum": [
              "organic_listing",
              "sponsored_ad",
              "quoted_rfq"
            ]
          },
          "price_signal_role": {
            "const": "benchmark_ceiling"
          },
          "unit_price_original_minor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          },
          "unit_price_gbp_pence": {
            "type": "integer",
            "minimum": 0
          },
          "offer_total_original_minor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "offer_total_gbp_pence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "quoted_quantity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "quoted_quantity_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_basis_qty": {
            "type": [
              "number",
              "null"
            ]
          },
          "price_basis_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "minimum_order_quantity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "lead_time_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "includes_shipping": {
            "type": "boolean"
          },
          "ship_from_country": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_of_origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_of_dispatch": {
            "type": [
              "string",
              "null"
            ]
          },
          "incoterm": {
            "type": [
              "string",
              "null"
            ]
          },
          "listing_pack_qty": {
            "type": [
              "number",
              "null"
            ]
          },
          "listing_pack_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "normalized_unit_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_used_or_refurbished": {
            "type": "boolean"
          },
          "is_ready_to_ship": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "vat_inclusive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "compliance_evidence_tier": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "structured_attribute",
              "title_body_mention",
              "absent"
            ]
          },
          "match_confidence_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "quote_usability_confidence_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "shipping_basis_confidence_bps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000
          },
          "quote_realism_confidence_bps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000
          },
          "query_wave_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4
          },
          "evidence_states_json": {
            "type": "object"
          },
          "evidence": {
            "type": "string"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraction_metadata": {
      "type": "object",
      "required": [
        "skill_version",
        "browser_profile_path",
        "session_transcript_path",
        "batch_started_at",
        "batch_completed_at"
      ],
      "properties": {
        "skill_version": {
          "type": "string"
        },
        "browser_profile_path": {
          "type": "string"
        },
        "session_transcript_path": {
          "type": "string"
        },
        "batch_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "batch_completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "chrome_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_browser_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
