{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "batch_id", "last_completed_profile_id", "last_completed_wave"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_id":       { "type": "string" },
    "last_completed_profile_id": { "type": ["string", "null"] },
    "last_completed_wave":       { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
    "completed_profile_ids":     { "type": "array", "items": { "type": "string" } },
    "inflight_profile_id":       { "type": ["string", "null"] },
    "inflight_wave":             { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
    "browser_attach_state":      { "type": "object" },
    "auth_refresh_state": {
      "type": ["string", "null"],
      "enum": [null, "verified", "required", "failed"]
    },
    "lexicon_expansion_required_profile_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "regulated_goods_suppressed_quote_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
