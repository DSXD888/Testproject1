{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "fx_status",
    "source_currency",
    "target_currency",
    "rate",
    "checked_at",
    "warnings",
    "blockers"
  ],
  "properties": {
    "fx_status": { "type": "string" },
    "source_currency": { "type": "string" },
    "target_currency": { "type": "string" },
    "rate": { "type": "number" },
    "checked_at": { "type": "string" },
    "converted_amount_gbp_pence": { "type": ["integer", "null"] },
    "source": { "type": ["string", "null"] },
    "warnings": { "type": "array" },
    "blockers": { "type": "array" }
  }
}
