{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "fx_status",
    "checked_at",
    "snapshots",
    "warnings",
    "blockers"
  ],
  "properties": {
    "fx_status": { "enum": ["converted", "partial", "blocked"] },
    "source_currency": { "type": "string" },
    "target_currency": { "const": "GBP" },
    "checked_at": { "type": "string", "format": "date-time" },
    "converted_amount_gbp_pence": { "type": ["integer", "null"] },
    "source": { "type": ["string", "null"] },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "basis",
          "base_currency",
          "quote_currency",
          "rate",
          "rate_bps",
          "source_url",
          "snapshot_id"
        ],
        "properties": {
          "basis": {
            "enum": ["hmrc_customs_monthly", "frankfurter_commercial_spot"]
          },
          "effective_month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "effective_date": {
            "type": "string",
            "format": "date"
          },
          "base_currency": {
            "type": "string",
            "minLength": 3
          },
          "quote_currency": { "const": "GBP" },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rate_bps": {
            "type": "integer",
            "minimum": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "blocker"] }
      },
      "additionalProperties": false
    }
  }
}
