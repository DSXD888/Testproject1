{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_candidate_id",
    "selected_quote_id",
    "classification_status",
    "commodity_confidence_bps",
    "classification_stability_bps",
    "customs_duty_gbp_pence",
    "trade_remedy_duty_gbp_pence",
    "vat_rate_bps",
    "warnings",
    "blockers"
  ],
  "properties": {
    "source": { "type": "string" },
    "product_candidate_id": { "type": "string" },
    "selected_quote_id": { "type": "string" },
    "classification_status": { "type": "string" },
    "declarable_commodity_code_10": { "type": ["string", "null"] },
    "commodity_description": { "type": ["string", "null"] },
    "candidate_commodity_codes": { "type": "array" },
    "commodity_confidence_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "classification_stability_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "origin_country": { "type": ["string", "null"] },
    "origin_evidence_state": { "type": ["string", "null"] },
    "basic_duty_rate_bps": { "type": ["integer", "null"] },
    "vat_rate_bps": { "type": "integer", "minimum": 0 },
    "customs_duty_gbp_pence": { "type": "integer", "minimum": 0 },
    "trade_remedy_duty_gbp_pence": { "type": "integer", "minimum": 0 },
    "trade_remedy_state": { "type": ["string", "null"] },
    "trade_remedy_cases": { "type": "array" },
    "duty_breakdown": { "type": "array" },
    "additional_codes": { "type": ["array", "object", "string", "null"] },
    "additional_code_requirements": { "type": ["array", "object", "null"] },
    "supplementary_units_required": { "type": "array" },
    "measure_interaction": { "type": ["array", "object", "null"] },
    "tariff_checked_at": { "type": ["string", "null"] },
    "measures_fresh_until": { "type": ["string", "null"] },
    "classification_fresh_until": { "type": ["string", "null"] },
    "warnings": { "type": "array" },
    "blockers": { "type": "array" }
  }
}
