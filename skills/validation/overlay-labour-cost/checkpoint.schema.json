{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "kind",
    "message",
    "domain_checks_seen",
    "worker_result_status",
    "downstream_route"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "labour_cost_overlay_checkpoint"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "domain_checks_seen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hours_scope_consistency",
          "regional_rate_bounds",
          "postcode_region_plausibility",
          "access_equipment_proportionality",
          "permit_responsibility_handling",
          "warning_completeness"
        ]
      },
      "uniqueItems": true
    },
    "worker_result_status": {
      "type": "string",
      "enum": ["estimated", "partial", "blocked", "unavailable"]
    },
    "downstream_route": {
      "type": "string",
      "enum": ["pass", "review"]
    }
  },
  "additionalProperties": false
}
