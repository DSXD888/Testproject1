{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["kind", "message", "domain_checks_seen"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "supplier_enrichment_overlay_checkpoint"
    },
    "message": {
      "type": "string"
    },
    "domain_checks_seen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "price_plausibility",
          "currency_correctness",
          "pack_basis_consistency",
          "seller_diversity",
          "listing_freshness",
          "regulated_goods_compliance_evidence"
        ]
      }
    }
  },
  "additionalProperties": false
}
