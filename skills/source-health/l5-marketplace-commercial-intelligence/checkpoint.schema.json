{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "seq",
    "source_id",
    "check"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "source_id": {
      "type": "string",
      "enum": [
        "alibaba",
        "1688",
        "amazon",
        "pcs",
        "searates",
        "freightos",
        "taric"
      ]
    },
    "check": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "skipped"
      ]
    },
    "evidence_path": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
