{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "line_items",
    "pricing_summary",
    "field_confidences",
    "extraction_confidence_bps",
    "warnings",
    "evidence_anchors",
    "extraction_metadata"
  ],
  "properties": {
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_number",
          "description",
          "lot_number",
          "quantity",
          "unit",
          "unit_rate_pence",
          "total_value_pence",
          "currency",
          "source_table_key",
          "repeated_header_normalized",
          "evidence_anchor"
        ],
        "properties": {
          "item_number": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "lot_number": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_rate_pence": {
            "type": "integer",
            "minimum": 0
          },
          "total_value_pence": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          },
          "source_table_key": {
            "type": "string"
          },
          "repeated_header_normalized": {
            "type": "boolean"
          },
          "evidence_anchor": {
            "type": "object",
            "required": [
              "page_ref",
              "anchor_text"
            ],
            "properties": {
              "page_ref": {
                "type": "string"
              },
              "anchor_text": {
                "type": "string"
              },
              "section_ref": {
                "type": "string"
              },
              "table_ref": {
                "type": "string"
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "pricing_summary": {
      "type": "object",
      "required": [
        "total_value_pence",
        "currency",
        "lot_count"
      ],
      "properties": {
        "total_value_pence": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "lot_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "field_confidences": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "extraction_confidence_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_ref",
          "anchor_text"
        ],
        "properties": {
          "page_ref": {
            "type": "string"
          },
          "anchor_text": {
            "type": "string"
          },
          "section_ref": {
            "type": "string"
          },
          "table_ref": {
            "type": "string"
          }
        }
      }
    },
    "extraction_metadata": {
      "type": "object",
      "required": [
        "target_domain",
        "extraction_scope",
        "source_markdown_hash",
        "policy_version"
      ],
      "properties": {
        "target_domain": {
          "type": "string",
          "const": "pricing"
        },
        "extraction_scope": {
          "type": "string"
        },
        "source_markdown_hash": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "items_examined": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
