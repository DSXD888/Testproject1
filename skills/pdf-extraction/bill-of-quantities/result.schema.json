{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "items",
    "summary",
    "field_confidences",
    "extraction_confidence_bps",
    "warnings",
    "evidence_anchors",
    "extraction_metadata"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_key",
          "item_ref",
          "description",
          "quantity",
          "unit",
          "unit_rate_pence",
          "total_pence",
          "lot_number",
          "section_ref",
          "continuation_of_item_key",
          "evidence_anchor"
        ],
        "properties": {
          "item_key": {
            "type": "string"
          },
          "item_ref": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_rate_pence": {
            "type": [
              "integer",
              "null"
            ]
          },
          "total_pence": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lot_number": {
            "type": "string"
          },
          "section_ref": {
            "type": "string"
          },
          "continuation_of_item_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_anchor": {
            "$ref": "#/$defs/evidenceAnchor"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "item_count",
        "total_value_pence"
      ],
      "properties": {
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_value_pence": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "field_confidences": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "extraction_confidence_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceAnchor"
      }
    },
    "extraction_metadata": {
      "type": "object",
      "required": [
        "target_domain",
        "extraction_scope",
        "source_markdown_hash",
        "policy_version"
      ],
      "properties": {
        "target_domain": {
          "type": "string",
          "const": "quantities"
        },
        "extraction_scope": {
          "type": "string"
        },
        "source_markdown_hash": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "document_role": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "evidenceAnchor": {
      "type": "object",
      "required": [
        "page_ref",
        "anchor_text"
      ],
      "properties": {
        "page_ref": {
          "type": "string"
        },
        "anchor_text": {
          "type": "string"
        },
        "section_ref": {
          "type": "string"
        }
      }
    }
  }
}
