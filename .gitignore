# Scheduled-task lock files written by the harness
.claude/scheduled_tasks.lock

# Timestamped backups created by the agent-mail coordination repair on 2026-05-01
*.mcp.json.*.bak
.opencode.json.*.bak
.claude/.settings.local.json.*.bak

# One-off diagnostic screenshots from skill investigation runs
searates-logistics-explorer.png
docs/pipeline/stage-14-phase-2-screenshots/debug-*.png

# Personal new-laptop setup file — explicitly self-marked "do NOT commit"
# (contains placeholders for secrets; copy from source machine, don't share)
new-laptop-setup.md

# Phase B precommit-hook bypass audit log (path lives under .git/ which git
# already ignores — entry kept for documentation/discoverability).
.git/agent-mail-bypasses.log

# Local repo-transfer scan output (scratch). Contains a secrets.txt that
# enumerates token/credential locations — must never be committed.
.transfer-scan/
