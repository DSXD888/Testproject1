{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["vite/client", "node"]
  },
  "include": [
    "index.html",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/ui/**/*.ts",
    "../../packages/ui/**/*.tsx",
    "../../packages/intelligence/src/**/*.ts",
    "vite-plugin-tauri-dev-bridge.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "../../packages/intelligence/src/**/*.test.ts"
  ]
}
